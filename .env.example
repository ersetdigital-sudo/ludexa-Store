# Satu project Supabase untuk semua brand.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Harus sama dengan brands.slug milik web ini.
BRAND_SLUG=ludexa-store

# Opsional. Dipakai untuk metadata dan redirect email reset password.
NEXT_PUBLIC_SITE_URL=https://ludexastore.com

# Server-only. Jangan pernah dipakai di browser dan jangan diberi prefix NEXT_PUBLIC_.
# Hanya diisi bila modul server memang membutuhkannya.
# SUPABASE_SERVICE_ROLE_KEY=
